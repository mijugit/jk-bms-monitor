// Copy this file to secrets.h and fill in your values.
// secrets.h is gitignored — never commit real WiFi credentials or the device key.

#pragma once

// One entry per WiFi network the device might be in range of (e.g. home vs.
// a second location). At boot/reconnect, the firmware scans and connects to
// whichever of these is actually in range — if more than one is, it picks
// the strongest signal. Add as many entries as you need.
struct WifiCredential {
    const char *ssid;
    const char *password;
};

static const WifiCredential WIFI_NETWORKS[] = {
    {"your-first-wifi-name", "your-first-wifi-password"},
    {"your-second-wifi-name", "your-second-wifi-password"},
};
static const int WIFI_NETWORK_COUNT = sizeof(WIFI_NETWORKS) / sizeof(WIFI_NETWORKS[0]);

// This device's row in the `devices` table on the server (name + device_key).
#define DEVICE_KEY "paste-the-device_key-from-the-devices-table-here"

// Full ingest endpoint URL, e.g. https://jkbms.timeflow.fun/api/ingest
#define INGEST_URL "https://jkbms.timeflow.fun/api/ingest"
