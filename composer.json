{
    "name": "jkbms/monitor",
    "description": "JK BMS Monitor — remote monitoring for JK BMS-managed LiFePO4 energy banks",
    "type": "project",
    "require": {
        "php": "^8.2",
        "ext-pdo": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "phpstan/phpstan": "^2.2"
    },
    "autoload": {
        "psr-4": {
            "JKBMS\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JKBMS\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit --testdox",
        "stan": "phpstan analyse"
    },
    "config": {
        "optimize-autoloader": true
    }
}
